# Gemini (agente)
GEMINI_API_KEY=

# Modelo a usar de Gemini
GEMINI_MODEL=gemini-2.5-flash

# Acceso a la API (query ?api_key=). Copiar a .env y no subir .env al repo.
API_KEY=cambia-esta-clave

# Máximo de peticiones por clave en 60 s
RATE_LIMIT_PER_MINUTE=30

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:8501,http://localhost:3000

# Segundos máximos por turno (POST /ask y /approve)
ASK_TIMEOUT_SECONDS=300

# PostgreSQL (obligatorio). Misma password que POSTGRES_PASSWORD del contenedor.
# - API con uvicorn en el PC → 127.0.0.1
# - API en Docker (Windows/macOS) → host.docker.internal
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/postgres
